#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: ShareIo
# Runs the ShareIo file sharing server
# ==============================================================================

# Config keys of the bundled server (fixed upstream names)
readonly PREFIX=sharry.restserver
declare host
declare port
declare username
declare password
declare property
declare value
declare override
declare base_url
declare log_level
declare db_type=mariadb
declare database=shareio
declare -a conf_props=()

# Set DB URL
bashio::log.debug "Setting DB URL..."
if ! bashio::config.is_empty 'remote_db_host'; then
    db_type=$(bashio::config 'remote_db_type')
    host=$(bashio::config 'remote_db_host')
    port=$(bashio::config 'remote_db_port')
    username=$(bashio::config 'remote_db_username')
    password=$(bashio::config 'remote_db_password')
    database=$(bashio::config 'remote_db_database')
else
    host=$(bashio::services 'mysql' 'host')
    port=$(bashio::services 'mysql' 'port')
    username=$(bashio::services 'mysql' 'username')
    password=$(bashio::services 'mysql' 'password')
fi
conf_props+=( \
    "-D${PREFIX}.backend.jdbc.url=jdbc:${db_type}://${host}:${port}/${database}" \
    "-D${PREFIX}.backend.jdbc.user=${username}" \
    "-D${PREFIX}.backend.jdbc.password=${password}" \
)

# Set base URL
# With a public URL, share links use it. Without one, the web app uses the
# address the page was opened with (NGINX handles that), and this value is
# only a fallback for server-generated links.
bashio::log.debug "Setting base URL for ShareIo..."
if ! bashio::config.is_empty 'base_url'; then
    base_url="$(bashio::config 'base_url')"
    bashio::log.info "Public URL: ${base_url}"
else
    base_url='http://homeassistant.local'
    if bashio::var.has_value "$(bashio::addon.port 9090)"; then
        base_url+=":$(bashio::addon.port 9090)"
    fi
    bashio::log.info "No public URL set; links use the address ShareIo is opened with"
fi
conf_props+=("-D${PREFIX}.base-url=${base_url}")

# Server secret: configured, or generated by cont-init.d/30-config.sh
bashio::log.debug "Adding in secret, language, theme and share config options..."
if bashio::config.is_empty 'server_secret'; then
    conf_props+=("-D${PREFIX}.backend.auth.server-secret=hex:$(cat /data/server_secret)")
else
    conf_props+=("-D${PREFIX}.backend.auth.server-secret=$(bashio::config 'server_secret')")
fi

if ! bashio::config.is_empty 'theme'; then
    conf_props+=("-D${PREFIX}.webapp.initial-theme=$(bashio::config 'theme')")
fi

if ! bashio::config.is_empty 'default_language'; then
    conf_props+=("-D${PREFIX}.webapp.default-language=$(bashio::config 'default_language')")
fi

if bashio::config.exists 'share_max_size_gb'; then
    conf_props+=("-D${PREFIX}.backend.share.max-size=$(bashio::config 'share_max_size_gb')g")
fi

if bashio::config.exists 'share_max_valid_days'; then
    conf_props+=("-D${PREFIX}.backend.share.max-validity=$(bashio::config 'share_max_valid_days')d")
fi

# --- SET LOG LEVEL ---
# Can't be set with arguments or env variables, search & replace config file
case "$(bashio::config 'log_level')" in \
    trace)      log_level='Trace' ;; \
    debug)      log_level='Debug' ;; \
    notice)     ;& \
    warning)    log_level='Warn' ;; \
    error)      ;& \
    fatal)      log_level='Error' ;; \
    *)          log_level='Info' ;; \
esac;
bashio::log.info "ShareIo log level set to ${log_level}"
conf_props+=("-D${PREFIX}.logging.minimum-level=${log_level}")

# Load server overrides ("property=value") last so they take precedence
# (protected properties are rejected in cont-init.d/30-config.sh). Values are
# passed as-is: exec arguments need no quoting.
if bashio::config.has_value 'server_overrides'; then
    bashio::log.debug "Loading 'server_overrides'..."
    while IFS= read -r override; do
        [[ -z "${override}" ]] && continue
        property="${override%%=*}"
        value="${override#*=}"
        if [[ ${property} =~ secret|password ]]; then
            bashio::log.info "Setting ${property} to ******"
        else
            bashio::log.info "Setting ${property} to ${value}"
        fi
        conf_props+=("-D${property}=${value}")
    done < <(bashio::config 'server_overrides')
fi

# Print all config options for debugging
bashio::log.debug
bashio::log.debug "Printing all startup flags being provided to the ShareIo server..."
for prop in "${conf_props[@]}"; do
    bashio::log.debug "${prop}"
done
bashio::log.debug

bashio::log.info "Handing over control to the ShareIo server..."
exec s6-setuidgid abc \
    /opt/shareio/bin/sharry-restserver "${conf_props[@]}" -- /etc/shareio/shareio.conf
