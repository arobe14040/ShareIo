#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: ShareIo
# Runs NGINX, which serves ShareIo to Home Assistant ingress and the direct port
# ==============================================================================

# Without a public URL, make the direct-access web app use the address the
# page was opened with (IP, hostname or proxy), so no address must be set.
mkdir -p /run/shareio
if bashio::config.is_empty 'base_url'; then
    echo "sub_filter 'var storedAccount = ' 'sharryFlags.baseUrl = window.location.origin; var storedAccount = ';" \
        > /run/shareio/nginx-public.conf
else
    : > /run/shareio/nginx-public.conf
fi

# First-run setup: until a storage location is chosen, the sidebar shows a
# setup screen (setup.js) that can browse folders in /share and /media.
setup=false
bashio::config.is_empty 'storage_location' && setup=true
printf '{"setup":%s,"slug":"%s","path":"%s"}\n' \
    "${setup}" "$(bashio::addon.slug)" "$(cat /data/storage_last)" > /run/shareio/state.json
if [[ "${setup}" == true ]]; then
    cat > /run/shareio/nginx-setup.conf <<'EOF'
location ~ ^/app/shareio-setup/browse/(share|media)(/.*)?$ {
    limit_except GET { deny all; }
    alias /$1$2;
    autoindex on;
    autoindex_format json;
    add_header Cache-Control "no-store";
}
EOF
else
    : > /run/shareio/nginx-setup.conf
fi

# Wait for the ShareIo server before accepting connections
bashio::net.wait_for 9091 127.0.0.1 300

bashio::log.info "Starting NGINX..."
exec nginx -g "daemon off;"
